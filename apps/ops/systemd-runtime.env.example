# Acrescente estas variáveis ao /opt/nistiprint/.env no servidor.
# Redis de ingest e filas legadas durante o rollout.
INGEST_REDIS_URL=redis://172.21.0.4:6379/0
INGEST_CLAIM_TIMEOUT_SECONDS=5
INGEST_REDIS_SOCKET_TIMEOUT_SECONDS=15
INGEST_SIGNATURE_VERDICT_GRACE_SECONDS=30
REDIS_HOST=172.21.0.4
REDIS_PORT=6379

# Fase 1: preserve o broker atual para não abandonar tarefas pendentes.
CELERY_BROKER_URL=redis://172.21.0.4:6379/0
CELERY_RESULT_BACKEND=redis://172.21.0.4:6379/0

# Cache e rate limit dedicados.
CACHE_REDIS_HOST=172.21.0.3
CACHE_REDIS_PORT=6379

WEBHOOK_SPOOL_DIR=/var/lib/nistiprint/webhook-spool

# Começar em optional até validar amostras reais de todos os providers.
INGEST_SIGNATURE_POLICY_SHOPEE=optional
INGEST_SIGNATURE_POLICY_MERCADOLIVRE=optional
INGEST_SIGNATURE_POLICY_BLING=optional

# Ativar somente depois de configurar o bucket e testar restauração.
INGEST_ARCHIVE_ENABLED=0
