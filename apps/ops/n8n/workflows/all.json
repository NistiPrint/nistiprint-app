      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nlet raw;\nif (item.binary?.data) raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nelse if (typeof item.json.rawBody === 'string') raw = Buffer.from(item.json.rawBody, 'utf8');\nelse if (typeof item.json.body === 'string') raw = Buffer.from(item.json.body, 'utf8');\nelse raw = Buffer.from(JSON.stringify(item.json.body ?? {}), 'utf8');\nconst rawBody = raw.toString('utf8');\nlet parsedPayload = null;\ntry { parsedPayload = JSON.parse(rawBody); } catch {}\nconst headers = item.json.headers ?? {};\nconst allow = ['content-type','user-agent','x-bling-signature-256','x-signature','x-shopee-signature','x-request-id','x-signature-version','x-signature-ts'];\nconst safeHeaders = {};\nfor (const key of allow) if (headers[key] !== undefined) safeHeaders[key] = String(headers[key]).slice(0, 2048);\nconst payload = parsedPayload ?? (typeof item.json.body === 'object' ? item.json.body : null);\nreturn [{ json: { schema_version: 1, event_id: crypto.randomUUID(), source: 'mercadolivre', received_at: new Date().toISOString(), headers: safeHeaders, raw_body: rawBody, parsed_payload: payload, body_sha256: crypto.createHash('sha256').update(raw).digest('hex'), provider_delivery_id: headers['x-request-id'] ?? payload?.id ?? payload?.resource ?? null, payload_size: raw.length, oversized: raw.length > 1048576 } }];"
        },
