        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const crypto = require('crypto');\nconst webhook = $('Shopee Webhook').first().json;\nconst envelope = $('Build Durable Envelope').first().json;\nconst provided = String(webhook.headers?.authorization ?? '').trim();\nconst partnerKey = String($env.SHOPEE_PARTNER_KEY ?? '').trim();\nconst callbackUrl = String(webhook.webhookUrl ?? $env.SHOPEE_CALLBACK_URL ?? '').trim();\nlet status = 'discarded_signature_unverifiable';\nif (provided && partnerKey && callbackUrl && envelope.raw_body) {\n  const calculated = crypto.createHmac('sha256', partnerKey).update(callbackUrl + '|' + envelope.raw_body, 'utf8').digest('hex');\n  const validShape = /^[a-f0-9]{64}$/i.test(provided);\n  const valid = validShape && crypto.timingSafeEqual(Buffer.from(calculated, 'hex'), Buffer.from(provided, 'hex'));\n  status = valid ? 'signature_valid' : 'discarded_invalid_signature';\n}\nreturn [{ json: { event_id: envelope.event_id, signature_status: status, checked_at: new Date().toISOString() } }];"
