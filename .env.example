# ============================================
# Supabase Configuration
# ============================================
# Obtenha estas chaves em: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================
# Shopee Configuration
# ============================================
# Credenciais da API Shopee (Partner ID e Key)
# Obtidos em: https://partner.shopeemobile.com/

SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key

# ============================================
# Worker Logging
# ============================================
WORKER_LOG_LEVEL=INFO
WORKER_LOG_FILE=/var/log/nistiprint/worker.log
WORKER_LOG_BACKUP_COUNT=30

# ============================================
# Archive Logs on Host
# ============================================
# Direto para JSONL no host para logs sem uso na interface web
NISTIPRINT_LOG_ARCHIVE_DIR=/var/log/nistiprint/archive

INTEGRATION_SECRETS_MASTER_KEY_V1=sua_chave_de_32_bytes_em_base64_aqui==

# ============================================
# Como usar:
# ============================================
# 1. Copie este arquivo para .env
# 2. Preencha com suas credenciais do Supabase e Shopee
# 3. Execute o script:
#    python scripts/fix_orphan_vinculos.py --dry-run

# ============================================
# Comandos disponíveis:
# ============================================
# --dry-run         Apenas diagnóstico
# --create-dummies  Cria placeholders
# --remove-orphans  Remove vínculos órfãos

# Marketplace lifecycle rollout: false records comparisons; true projects guarded status transitions.
MARKETPLACE_LIFECYCLE_PROJECTION_ENABLED=false

# Redis acessado pelos processos systemd no host
INGEST_REDIS_URL=redis://127.0.0.1:6379/0

# Importante: impedir que o Celery tente usar o hostname Docker redis-celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_IGNORE_RESULT=true
CELERY_TASK_STORE_ERRORS_EVEN_IF_IGNORED=false

WEBHOOK_SPOOL_DIR=/var/lib/nistiprint/webhook-spool

INGEST_SIGNATURE_VERDICT_GRACE_SECONDS=30

# Começar permissivo até confirmar todas as assinaturas reais
# MARKETPLACE_WEBHOOK_TOKEN removido em 02/08/2026 junto com as rotas
# POST /api/v2/webhooks/{shopee,mercadolivre}. O n8n escreve direto no Redis e a
# inbox passa a ter uma unica porta. Pode remover a variavel do seu ambiente.

INGEST_SIGNATURE_POLICY_SHOPEE=optional
# observe = valida e registra o veredito, mas nunca descarta. Use ao estrear ou
# trocar a fonte do segredo; promova para optional depois de confirmar no log.
INGEST_SIGNATURE_POLICY_BLING=observe
INGEST_SIGNATURE_POLICY_MERCADOLIVRE=optional

# Fallback de emergencia. A fonte dos segredos e installed_integrations.credentials.client_secret.
# Deixe VAZIO ou remova: um placeholder aqui derruba o ingest (ver docs/tecnico/diagnostico-agendamentos-ingest-2026-08-01.md).
INGEST_WEBHOOK_SECRETS_BLING=
INGEST_WEBHOOK_SECRETS_MERCADOLIVRE=

# Arquivamento permanece desligado inicialmente
INGEST_ARCHIVE_ENABLED=0

INGEST_CLAIM_TIMEOUT_SECONDS=5
INGEST_REDIS_SOCKET_TIMEOUT_SECONDS=15

MARKETPLACE_ADAPTER_MODE_SHOPEE=legacy
MARKETPLACE_ADAPTER_MODE_MERCADOLIVRE=legacy

# ---------------------------------------------------------------------------
# IA de personalizacao
# ---------------------------------------------------------------------------
# Apenas as CHAVES vivem aqui. Qual provedor e qual modelo usar sao
# configuracao de aplicacao (`configuracoes_aplicacao`, chaves `ia_provider`,
# `ia_model`, `ia_fallback_provider`, `ia_timeout_seconds`) e mudam pela tela de
# /personalizados/config, sem deploy.
#
# Deixe vazio o provedor que nao for usar: sem chave, o provedor apenas se
# declara indisponivel — nao derruba o processamento se houver fallback.

# Gemini (google-genai)
NISTIPRINT_AI_KEY=

# OpenRouter — suporta `openrouter/auto` (roteamento automatico de modelo)
OPENROUTER_API_KEY=
# Cabecalhos de atribuicao do OpenRouter (opcionais)
OPENROUTER_APP_URL=https://nistiprint.local
OPENROUTER_APP_TITLE=NistiPrint